{
	"info": {
		"_postman_id": "8733dcdc-f2cf-463c-a569-d2d1847d24f5",
		"name": "PC Power Calc — ЛР3 API",
		"description": "Веб-сервис расчёта мощности блока питания (тема 18). 10 запросов — по одному на каждый метод: 7 домена компонентов и 3 домена пользователей. Выполнять по порядку 01–10. Ответы — сами данные без обёрток, результат — HTTP-код.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 GET Список компонентов (фильтр по мощности)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);",
							"const list = pm.response.json();",
							"pm.test(\"Ответ — массив без обёрток\", () => pm.expect(list).to.be.an(\"array\"));",
							"pm.test(\"Все мощности <= 300\", () => list.forEach(c => pm.expect(c.power_watt).to.be.at.most(300)));",
							"pm.test(\"Признак is_mine 0/1\", () => list.forEach(c => pm.expect([0, 1]).to.include(c.is_mine)));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/power_components?max_power=300",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"power_components"
					],
					"query": [
						{
							"key": "max_power",
							"value": "300"
						}
					]
				},
				"description": "Только опубликованные. max_power — мощность до, Вт (0–500). is_mine = 1, если создатель — текущий пользователь: по нему плитка показывает кнопку «Удалить» только у своих карточек."
			}
		},
		{
			"name": "02 POST Добавление компонента с фото и видео",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
							"pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);",
							"const d = pm.response.json();",
							"pm.collectionVariables.set(\"componentId\", d.id);",
							"pm.test(\"Статус draft\", () => pm.expect(d.status).to.eql(\"draft\"));",
							"pm.test(\"Фото в MinIO\", () => pm.expect(d.image_url).to.include(\"/power-components/power_component_\"));",
							"pm.test(\"Видео в MinIO\", () => pm.expect(d.video_url).to.include(\"/power-components/power_component_\"));"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/power_components",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"power_components"
					]
				},
				"description": "multipart/form-data: title, image (PNG/JPEG/GIF/WEBP до 5 МБ), video (MP4/MOV/WEBM до 50 МБ). Файлы сохраняются в MinIO, ссылки — в image_url и video_url. Id созданного черновика сохраняется в переменную componentId.",
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "title",
							"value": "be quiet! Pure Power 12 M 750W",
							"type": "text"
						},
						{
							"key": "image",
							"type": "file",
							"src": "C:\\Users\\erofe\\Documents\\Материалы_МГТУ\\5_semestr\\РИП\\psu-calculator-backend\\static\\img\\default-component.png"
						},
						{
							"key": "video",
							"type": "file",
							"src": "C:\\Users\\erofe\\Documents\\Материалы_МГТУ\\5_semestr\\РИП\\psu-calculator-backend\\static\\video\\default-component.mp4"
						}
					]
				}
			}
		},
		{
			"name": "03 GET Черновик текущего пользователя",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);",
							"pm.test(\"Тот же черновик\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"componentId\"))));",
							"pm.test(\"Статус draft\", () => pm.expect(pm.response.json().status).to.eql(\"draft\"));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/power_components/draft",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"power_components",
						"draft"
					]
				},
				"description": "Ид не указывается: черновик берётся по пользователю-константе (singleton)."
			}
		},
		{
			"name": "04 PUT Публикация черновика",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);",
							"const d = pm.response.json();",
							"pm.test(\"Статус published\", () => pm.expect(d.status).to.eql(\"published\"));",
							"pm.test(\"Заполнена дата формирования\", () => pm.expect(d.formed_at).to.not.be.null);"
						]
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/power_components/{{componentId}}/publish",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"power_components",
						"{{componentId}}",
						"publish"
					]
				},
				"description": "Статус draft -> published, formed_at = now(). Системные поля передавать нельзя.",
				"body": {
					"mode": "raw",
					"raw": "{\n  \"description\": \"Блок питания 750 Вт с сертификатом 80 PLUS Gold\",\n  \"power_watt\": 15,\n  \"weight_gram\": 1600\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			}
		},
		{
			"name": "05 GET Лента (без ид / по ид ?next=true)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);",
							"const d = pm.response.json();",
							"pm.test(\"Признак лайка is_liked 0/1\", () => pm.expect([0, 1]).to.include(d.is_liked));",
							"pm.test(\"Признак is_mine 0/1\", () => pm.expect([0, 1]).to.include(d.is_mine));",
							"pm.test(\"Вложенный creator\", () => pm.expect(d.creator).to.have.property(\"login\"));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/power_components/feed?power_component_id={{componentId}}&next=true",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"power_components",
						"feed"
					],
					"query": [
						{
							"key": "power_component_id",
							"value": "{{componentId}}",
							"description": "ID компонента. Выключить — лента без ид (первый опубликованный)",
							"disabled": true
						},
						{
							"key": "next",
							"value": "true",
							"description": "true — следующий опубликованный после ID",
							"disabled": true
						}
					]
				},
				"description": "Один метод ленты. Без параметров (галочки сняты) — первый опубликованный компонент, как при переходе с панели вкладок. С power_component_id — этот компонент, с power_component_id и next=true — следующий опубликованный после него (после последнего — снова первый). is_liked = 1, если текущий пользователь уже лайкнул компонент: лента по нему закрашивает сердце и решает, что отправить в POST лайка (like=0 или like=1). is_mine = 1 — свой компонент. creator — вложенная сериализация пользователя."
			}
		},
		{
			"name": "06 POST Лайк",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);",
							"pm.test(\"Лайк стоит\", () => pm.expect(pm.response.json().is_liked).to.eql(1));"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/power_components/{{componentId}}/like",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"power_components",
						"{{componentId}}",
						"like"
					]
				},
				"description": "like = 1 ставит лайк, like = 0 отменяет. Повторный лайк не дублируется.",
				"body": {
					"mode": "raw",
					"raw": "{\n  \"like\": 1\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			}
		},
		{
			"name": "07 DELETE Удаление компонента",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);",
							"pm.test(\"Статус deleted\", () => pm.expect(pm.response.json().status).to.eql(\"deleted\"));"
						]
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/power_components/{{componentId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"power_components",
						"{{componentId}}"
					]
				},
				"description": "Логическое удаление (status = deleted). Только свои компоненты."
			}
		},
		{
			"name": "08 POST Регистрация пользователя",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
							"pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);",
							"pm.test(\"Пароль не возвращается\", () => pm.expect(pm.response.json()).to.not.have.property(\"password\"));"
						]
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (!pm.collectionVariables.get(\"registerLogin\") || pm.collectionVariables.get(\"registerLogin\") === \"new_builder\") {",
							"  pm.collectionVariables.set(\"registerLogin\", \"builder_\" + Date.now().toString().slice(-6));",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/users/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"register"
					]
				},
				"description": "Пароль хранится в виде хеша PBKDF2-SHA256 и не возвращается в ответе.",
				"body": {
					"mode": "raw",
					"raw": "{\n  \"login\": \"{{registerLogin}}\",\n  \"password\": \"builder123\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			}
		},
