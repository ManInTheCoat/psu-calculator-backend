  },
  "item": [
    {
      "name": "Основные запросы",
      "item": [
        {
          "name": "01 GET Список компонентов (фильтр по мощности)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"status = success\", () => pm.expect(pm.response.json().status).to.eql(\"success\"));",
                  "pm.test(\"Все мощности <= 300\", () => pm.response.json().data.forEach(c => pm.expect(c.power_watt).to.be.at.most(300)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/power_components?max_power=300",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "power_components"
              ],
              "query": [
                {
                  "key": "max_power",
                  "value": "300"
                }
              ]
            },
            "description": "Только опубликованные. max_power — мощность до, Вт (0–500). is_mine = 1, если создатель — текущий пользователь."
          }
        },
        {
          "name": "02 POST Создание черновика с фото и видео",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Ответ в JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"status = success\", () => pm.expect(pm.response.json().status).to.eql(\"success\"));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"componentId\", d.id);",
                  "pm.test(\"Статус draft\", () => pm.expect(d.status).to.eql(\"draft\"));",
                  "pm.test(\"Фото в MinIO\", () => pm.expect(d.image_url).to.include(\"/power-components/power_component_\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/power_components",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "power_components"
              ]
            },
            "description": "multipart/form-data: title, image (PNG/JPEG/GIF/WEBP до 5 МБ), video (MP4/MOV/WEBM до 50 МБ). Файлы сохраняются в MinIO, ссылки — в image_url и video_url. Id созданного черновика сохраняется в переменную componentId.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "be quiet! Pure Power 12 M 750W",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": "C:\\Users\\erofe\\Documents\\Материалы_МГТУ\\5_semestr\\РИП\\psu-calculator-backend\\static\\img\\default-component.png"
                },
                {
                  "key": "video",
                  "type": "file",
