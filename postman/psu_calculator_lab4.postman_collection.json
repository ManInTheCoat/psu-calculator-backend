{
	"info": {
		"_postman_id": "eaa338fd-14f7-469f-8cb9-26596420f87f",
		"name": "PC Power Calc ЛР4",
		"description": "Веб-сервис расчета мощности блока питания (тема 18).\n\nАдреса и кука сессии указаны в запросах явно, переменные не используются.\nЗначение куки session_id берется в браузере после входа через Swagger (F12, Application, Cookies) и вставляется в заголовок Cookie каждого запроса.\nЕсли снять галочку у заголовка Cookie, запрос выполняется от гостя.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 GET Список компонентов",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Cookie",
						"value": "session_id=8b1a9854-56ee-4b51-9e3a-527f341d554d",
						"type": "text"
					}
				],
				"url": {
					"raw": "http://127.0.0.1:8000/api/power_components?max_power=300",
					"protocol": "http",
					"host": [
						"127",
						"0",
						"0",
						"1"
					],
					"port": "8000",
					"path": [
						"api",
						"power_components"
					],
					"query": [
						{
							"key": "max_power",
							"value": "300"
						}
					]
				}
			},
			"protocolProfileBehavior": {
				"disableCookies": true
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
							"const list = pm.response.json();",
							"pm.test(\"Массив компонентов\", () => pm.expect(list).to.be.an(\"array\"));",
							"pm.test(\"Мощность не больше 300\", () => list.forEach(c => pm.expect(c.power_watt).to.be.at.most(300)));"
						]
					}
				}
			]
		},
